---
import Layout from "../layouts/Layout.astro";

// ============================================
// À COMPLÉTER : tes infos personnelles
// ============================================
const nom = "Wellinger Chloé";
const role = "Développeuse — C# - .NET / Java / Python";
const summary =
  "Passionnée par le développement logiciel et la conception d'applications, curieuse et recherche de découvertes. J'aime explorer de nouvelles technologies et transformer des besoins en solutions concrètes.";

const apropos = [
  "Passionnée par le développement logiciel et la conception d'applications, curieuse et recherche de découvertes.",
  "J'aime explorer de nouvelles technologies et transformer des besoins en solutions concrètes.",
];

const specs = [
  { label: "Localisation", value: "Belgique" },
  { label: "Langues", value: "FR, EN" },
  { label: "Disponibilité", value: "Stage, Emploi" },
];

const formations = [
  {
    periode: "Depuis 2024",
    titre: "Haute École Robert Schuman",
    desc: "Bachelier en informatique de gestion / développement — spécialisation en développement d'applications.",
  },
];

const projets = [
  {
    nom: "Lexia",
    desc: "Application de planification des horaires développée dans le cadre scolaire réalisée pour l'ASBL Comprendre et Parler",
    tags: ["Java", "SpringBoot", "SQL Server"],
    lien: "https://github.com/HitsuK0/Lexia",
  },
  {
    nom: "DailyBackup",
    desc: "Conception et développement d'une application de gestion de sauvegardes, permettant de configurer les fichiers à sauvegarder, restaurer des données et réinitialiser les paramètres.",
    tags: ["C#", ".NET"],
    lien: "https://github.com/ton-pseudo/projet",
  },
  {
    nom: "Nom du projet",
    desc: "Une ou deux phrases expliquant ce que fait le projet et le problème qu'il résout.",
    tags: ["Kotlin", "Android"],
    lien: "https://github.com/ton-pseudo/projet",
  },
];

const stack = [
  {
    cat: "Langages",
    items: [
      { nom: "Java", icon: "java" },
      { nom: "C#", icon: "cs" },
      { nom: "Python", icon: "python" },
      { nom: "Kotlin", icon: "kotlin" },
    ],
  },
  {
    cat: "Bases de données",
    items: [
      { nom: "MySQL", icon: "mysql" },
      { nom: "PostgreSQL", icon: "postgres" },
      { nom: "MongoDB", icon: "mongodb" },
      { nom: "Oracle", icon: "oracle" },
    ],
  },
  {
    cat: "Web",
    items: [
      { nom: "HTML", icon: "html" },
      { nom: "CSS", icon: "css" },
      { nom: "Tailwind", icon: "tailwind" },
      { nom: "Bootstrap", icon: "bootstrap" },
    ],
  },
  {
    cat: "Frameworks",
    items: [
      { nom: "Spring", icon: "spring" },
      { nom: ".NET", icon: "dotnet" },
    ],
  },
  {
    cat: "Outils",
    items: [
      { nom: "Docker", icon: "docker" },
      { nom: "Git", icon: "git" },
      { nom: "GitHub", icon: "github" },
      { nom: "GitLab", icon: "gitlab" },
      { nom: "Linux", icon: "linux" },
      { nom: "VS Code", icon: "vscode" },
      { nom: "IntelliJ", icon: "idea" },
      { nom: "Visual Studio", icon: "visualstudio" },
    ],
  },
];

const contact = [
  {
    label: "Discord",
    valeur: "ton_pseudo",
    lien: null,
    icon: "https://skillicons.dev/icons?i=discord",
  },
  {
    label: "Email",
    valeur: "ton-email@proton.me",
    lien: "mailto:ton-email@proton.me",
    icon: "https://img.shields.io/badge/-000000?style=flat-square&logo=protonmail&logoColor=8B89CC",
  },
  {
    label: "GitHub",
    valeur: "github.com/ton-pseudo",
    lien: "https://github.com/ton-pseudo",
    icon: "https://skillicons.dev/icons?i=github",
  },
  {
    label: "LinkedIn",
    valeur: "linkedin.com/in/ton-profil",
    lien: "https://linkedin.com/in/ton-profil",
    icon: "https://skillicons.dev/icons?i=linkedin",
  },
];
---

<Layout title={`${nom} — Portfolio`}>
  <!-- NAVIGATION -->
  <header class="topbar">
    <div class="topbar-inner">
      <span class="mark">{nom}</span>
      <nav>
        <a href="#apropos">À propos</a>
        <a href="#formation">Formation</a>
        <a href="#projets">Projets</a>
        <a href="#stack">Stack</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>
  </header>

  <div class="wrap">
    <!-- HERO -->
    <section class="hero">
      <p class="eyebrow">Portfolio — {new Date().getFullYear()}</p>
      <h1>{nom}</h1>
      <div class="hero-grid">
        <div>
          <p class="role">{role}</p>
          <p class="summary">{summary}</p>
          <div class="cta-row">
            <a class="btn filled" href={contact.find((c) => c.label === "GitHub")?.lien} target="_blank">
              Voir GitHub
            </a>
            <a class="btn" href="#projets">Voir les projets</a>
          </div>
        </div>
      </div>
    </section>

    <!-- À PROPOS -->
    <section id="apropos" class="card card--pink">
      <div class="section-head">
        <p class="label">Présentation</p>
        <h2>À propos</h2>
      </div>
      <div class="about-grid">
        <div class="about-text">
          {apropos.map((p) => <p>{p}</p>)}
        </div>
        <dl class="spec-list">
          {
            specs.map((s) => (
              <div class="spec-row">
                <dt>{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- FORMATION -->
    <section id="formation" class="card card--blue">
      <div class="section-head">
        <p class="label">Parcours</p>
        <h2>Formation</h2>
      </div>
      <div>
        {
          formations.map((f) => (
            <div class="formation-row">
              <span class="period">{f.periode}</span>
              <div>
                <h3>{f.titre}</h3>
                <p>{f.desc}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- PROJETS -->
    <section id="projets" class="card card--pink">
      <div class="section-head">
        <p class="label">Sélection</p>
        <h2>Projets réalisés</h2>
      </div>
      <div>
        {
          projets.map((p) => (
            <a class="project-row" href={p.lien} target="_blank">
              <div class="project-row-top">
                <h3>{p.nom}</h3>
                <span class="arrow">↗</span>
              </div>
              <p>{p.desc}</p>
              <div class="tags">
                {p.tags.map((t) => <span>{t}</span>)}
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- STACK TECHNIQUE -->
    <section id="stack" class="card card--blue">
      <div class="section-head">
        <p class="label">Outils</p>
        <h2>Stack technique</h2>
      </div>
      {
        stack.map((s) => (
          <div class="stack-block">
            <span class="cat">{s.cat}</span>
            <div class="stack-chips">
              {
                s.items.map((i) => (
                  <div class="stack-chip">
                    <img src={`https://skillicons.dev/icons?i=${i.icon}`} alt={i.nom} loading="lazy" />
                    <span>{i.nom}</span>
                  </div>
                ))
              }
            </div>
          </div>
        ))
      }
    </section>

    <!-- CONTACT -->
    <section id="contact" class="card card--pink">
      <div class="section-head">
        <p class="label">Me contacter</p>
        <h2>Contact</h2>
      </div>
      <div class="contact-grid">
        {
          contact.map((c) =>
            c.lien ? (
              <a class="contact-row" href={c.lien} target="_blank">
                <img src={c.icon} alt={c.label} loading="lazy" />
                <span class="meta">
                  <span class="label">{c.label}</span>
                  <span class="value">{c.valeur}</span>
                </span>
              </a>
            ) : (
              <div class="contact-row">
                <img src={c.icon} alt={c.label} loading="lazy" />
                <span class="meta">
                  <span class="label">{c.label}</span>
                  <span class="value">{c.valeur}</span>
                </span>
              </div>
            )
          )
        }
      </div>
    </section>

    <footer>
      <p>&copy; {new Date().getFullYear()} {nom}</p>
    </footer>
  </div>
</Layout>